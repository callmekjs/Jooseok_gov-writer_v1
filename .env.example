ENVIRONMENT=development

# AI 키 — 서버가 이 키를 직접 들고 호출합니다. 최소 하나.
# ⚠️ 배포할 때도 값을 채우세요. 비우면 유료 라우트(말씀자료 생성 등)가 전부 401이 됩니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase — Task 10부터
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 접속 암호 — 서버 키 + 접속 암호 기능. 비워두면(로컬 개발 등) 암호 검사를 건너뛴다.
# ⚠️ 배포할 때 반드시 값을 채우세요. 비어 있으면 누구나 서버의 AI 키로 요청을 보낼 수 있습니다.
# 영문·숫자·기호만 사용하세요. 한글은 HTTP 헤더로 전달할 수 없습니다.
APP_PASSWORD=
